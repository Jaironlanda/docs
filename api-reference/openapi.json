{
  "openapi": "3.1.0",
  "info": {
    "title": "JSONsilo Manage API",
    "description": "Create, read, update, and delete silos programmatically with a Manage Key.\n\n**Authentication:** send your Manage Key in the `X-MAN-API` header on every request. Create one in the console under **Keys > Manage keys**.\n\n**Base URL:** `https://[region-code].jsonsilo.com/api/v1/manage`. For requests about a specific silo, use the base URL of the region the silo is stored in: `api` (Germany, default), `sg-01-api` (Singapore), or `usc-01-api` (United States).\n\n**Errors:** most error responses have a short plain-text body. `400` (invalid body), `402` (trial ended), and `422` (locked schema mismatch) return JSON.\n\n**Rate limits:** requests are limited per account by plan. Successful responses include `ManageSilo-Req-Limit`, `ManageSilo-Req-Remaining`, and `ManageSilo-Req-Reset` headers. See https://docs.jsonsilo.com/rate-limits.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://api.jsonsilo.com",
      "description": "Germany"
    },
    {
      "url": "https://sg-01-api.jsonsilo.com",
      "description": "Singapore"
    },
    {
      "url": "https://usc-01-api.jsonsilo.com",
      "description": "United States"
    }
  ],
  "paths": {
    "/api/v1/manage/silos": {
      "get": {
        "tags": [
          "Manage"
        ],
        "summary": "Get All Silos",
        "description": "API endpoint to list all user silos with pagination. Silos are returned newest first, 25 per page.",
        "operationId": "get_all_silos",
        "security": [
          {
            "silo_api_key": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page number to retrieve",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "total_items": {
                          "type": "integer",
                          "description": "The number of silos returned on this page",
                          "title": "Total Items",
                          "example": 1
                        },
                        "per_page": {
                          "type": "integer",
                          "description": "The number of silos per page",
                          "title": "Per Page",
                          "example": 25
                        },
                        "page_no": {
                          "type": "integer",
                          "description": "The current page number",
                          "title": "Page No",
                          "example": 1
                        }
                      }
                    },
                    "silos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file_name": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Silo name. The silo name will not affect development or any sensitive aspects.",
                            "example": "new db"
                          },
                          "file_uuid": {
                            "type": "string",
                            "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
                            "format": "uuid",
                            "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
                          },
                          "created_at": {
                            "type": "string",
                            "description": "The date and time the silo was created in `UTC`.",
                            "format": "date-time",
                            "example": "2026-11-07T12:52:28.094Z"
                          },
                          "updated_at": {
                            "type": "string",
                            "description": "The date and time the silo was last updated in `UTC`.",
                            "format": "date-time",
                            "example": "2026-11-07T12:52:28.094Z"
                          },
                          "is_public": {
                            "type": "boolean",
                            "description": "Silo access mode. If `true`, the silo is public; if `false`, the silo is private.",
                            "example": false
                          },
                          "region_name": {
                            "type": "string",
                            "description": "The region where your data will be stored.",
                            "example": "api"
                          },
                          "file_size_bytes": {
                            "type": "integer",
                            "description": "The size of the silo's JSON data in bytes.",
                            "example": 2048
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "204": {
            "description": "No Content. There are no silos on this page. The response has no body.",
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/TrialEnded"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/manage/meta/{file_uuid}": {
      "get": {
        "tags": [
          "Manage"
        ],
        "summary": "Get Silo Metadata",
        "description": "API endpoint to retrieve the metadata of a silo, without its data.",
        "operationId": "get_silo_meta",
        "security": [
          {
            "silo_api_key": []
          }
        ],
        "parameters": [
          {
            "name": "file_uuid",
            "in": "path",
            "required": true,
            "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Uuid"
            },
            "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file_uuid": {
                      "type": "string",
                      "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
                      "format": "uuid",
                      "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
                    },
                    "file_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Silo name. The silo name will not affect development or any sensitive aspects.",
                      "example": "new db"
                    },
                    "created_at": {
                      "type": "string",
                      "description": "The date and time the silo was created in `UTC`.",
                      "format": "date-time",
                      "example": "2026-11-07T12:52:28.094Z"
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "The date and time the silo was last updated in `UTC`.",
                      "format": "date-time",
                      "example": "2026-11-07T12:52:28.094Z"
                    },
                    "is_public": {
                      "type": "boolean",
                      "description": "Silo access mode. If `true`, the silo is public; if `false`, the silo is private.",
                      "example": false
                    },
                    "region_name": {
                      "type": "string",
                      "description": "The region where your data will be stored.",
                      "example": "api"
                    },
                    "user_uuid": {
                      "type": "string",
                      "description": "The ID of the account that owns the silo.",
                      "format": "uuid",
                      "example": "a3c2e8d0-5f4b-4e1a-9c7d-1b2e3f4a5b6c"
                    },
                    "file_size_bytes": {
                      "type": "integer",
                      "description": "The size of the silo's JSON data in bytes.",
                      "example": 2048
                    },
                    "has_schema": {
                      "type": "boolean",
                      "description": "Whether a JSON Schema is attached to the silo.",
                      "example": true
                    },
                    "schema_locked": {
                      "type": "boolean",
                      "description": "Whether the silo's schema is locked. While it is locked, an update whose `file_data` doesn't match the schema is rejected with `422`.",
                      "example": false
                    }
                  }
                }
              }
            },
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/TrialEnded"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/manage/{file_uuid}": {
      "get": {
        "tags": [
          "Manage"
        ],
        "summary": "Get Silo",
        "description": "API endpoint to retrieve silo data. The response body is the silo's JSON, exactly as stored.",
        "operationId": "get_silo",
        "security": [
          {
            "silo_api_key": []
          }
        ],
        "parameters": [
          {
            "name": "file_uuid",
            "in": "path",
            "required": true,
            "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Uuid"
            },
            "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response. The silo's JSON data.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "items": {},
                      "type": "array"
                    },
                    {
                      "type": "object"
                    }
                  ],
                  "title": "File Data",
                  "description": "The silo's JSON data."
                },
                "example": {
                  "name": "John Doe",
                  "age": 58
                }
              }
            },
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/TrialEnded"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "patch": {
        "tags": [
          "Manage"
        ],
        "summary": "Update Silo",
        "description": "API endpoint to update silo. Send only the fields you want to change. `file_data` replaces the silo's data completely.",
        "operationId": "update_silo",
        "security": [
          {
            "silo_api_key": []
          }
        ],
        "parameters": [
          {
            "name": "file_uuid",
            "in": "path",
            "required": true,
            "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Uuid"
            },
            "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSilo"
              },
              "examples": {
                "replace_data": {
                  "summary": "Replace the silo's data",
                  "description": "`file_data` replaces the whole document. Send the full JSON, not only the changed fields.",
                  "value": {
                    "file_data": {
                      "maintenance_mode": true,
                      "min_app_version": "2.4.0",
                      "features": {
                        "new_checkout": true
                      }
                    }
                  }
                },
                "rename": {
                  "summary": "Rename the silo",
                  "value": {
                    "file_name": "app-config-prod"
                  }
                },
                "make_public": {
                  "summary": "Make the silo public (changes its URL)",
                  "value": {
                    "is_public": true
                  }
                },
                "move_region": {
                  "summary": "Move the silo to another region (changes its URL)",
                  "value": {
                    "region_name": "usc-01-api"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file_uuid": {
                      "type": "string",
                      "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
                      "format": "uuid",
                      "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
                    },
                    "file_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Silo name. The silo name will not affect development or any sensitive aspects.",
                      "example": "new db"
                    },
                    "region_name": {
                      "type": "string",
                      "description": "The region where your data will be stored.",
                      "example": "api"
                    },
                    "is_public": {
                      "type": "boolean",
                      "description": "Silo access mode. If `true`, the silo is public; if `false`, the silo is private.",
                      "example": false
                    },
                    "file_data": {
                      "anyOf": [
                        {
                          "items": {},
                          "type": "array"
                        },
                        {
                          "type": "object"
                        }
                      ],
                      "description": "The data stored in the silo after the update.",
                      "title": "File Data",
                      "example": {
                        "maintenance_mode": true,
                        "min_app_version": "2.4.0",
                        "features": {
                          "new_checkout": true
                        }
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "description": "The date and time the silo was created in `UTC`.",
                      "format": "date-time",
                      "example": "2026-11-07T12:52:28.094Z"
                    },
                    "updated_at": {
                      "type": "string",
                      "description": "The date and time the silo was last updated in `UTC`.",
                      "format": "date-time",
                      "example": "2026-11-07T12:52:28.094Z"
                    }
                  }
                }
              }
            },
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/SchemaViolation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/TrialEnded"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": [
          "Manage"
        ],
        "summary": "Delete Silo",
        "description": "API endpoint to delete a silo. This cannot be undone.",
        "operationId": "delete_silo",
        "security": [
          {
            "silo_api_key": []
          }
        ],
        "parameters": [
          {
            "name": "file_uuid",
            "in": "path",
            "required": true,
            "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Uuid"
            },
            "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response. The silo was deleted. The response has no body.",
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/TrialEnded"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/manage": {
      "post": {
        "tags": [
          "Manage"
        ],
        "summary": "Create Silo",
        "description": "API endpoint to create a new silo. Your plan's limits on silo count, silo size, and regions apply.",
        "operationId": "create_silo",
        "security": [
          {
            "silo_api_key": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSilo"
              },
              "examples": {
                "private_object": {
                  "summary": "Private silo with a JSON object",
                  "value": {
                    "file_name": "app-config",
                    "file_data": {
                      "maintenance_mode": false,
                      "min_app_version": "2.4.0",
                      "features": {
                        "new_checkout": true
                      }
                    },
                    "region_name": "api",
                    "is_public": false
                  }
                },
                "public_array": {
                  "summary": "Public silo with an array, in Singapore",
                  "value": {
                    "file_name": "product-catalog",
                    "file_data": [
                      {
                        "id": 1,
                        "name": "Mug",
                        "price": 12.5
                      },
                      {
                        "id": 2,
                        "name": "T-shirt",
                        "price": 20
                      }
                    ],
                    "region_name": "sg-01-api",
                    "is_public": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file_uuid": {
                      "type": "string",
                      "description": "The Silo UUID, comprising 32 hexadecimal digits separated by 4 hyphens, totaling 36 characters.",
                      "format": "uuid",
                      "example": "f1b9b1b4-0b1b-4b1b-8b1b-2b1b1b1b1b1b"
                    },
                    "is_public": {
                      "type": "boolean",
                      "description": "Silo access mode. If `true`, the silo is public; if `false`, the silo is private.",
                      "example": false
                    },
                    "file_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Silo name. The silo name will not affect development or any sensitive aspects.",
                      "example": "new db"
                    },
                    "region_name": {
                      "type": "string",
                      "description": "The region where your data will be stored.",
                      "example": "api"
                    }
                  }
                }
              }
            },
            "headers": {
              "ManageSilo-Req-Limit": {
                "$ref": "#/components/headers/ManageSilo-Req-Limit"
              },
              "ManageSilo-Req-Remaining": {
                "$ref": "#/components/headers/ManageSilo-Req-Remaining"
              },
              "ManageSilo-Req-Reset": {
                "$ref": "#/components/headers/ManageSilo-Req-Reset"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/TrialEnded"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSilo": {
        "type": "object",
        "title": "CreateSilo",
        "required": [
          "file_data",
          "region_name"
        ],
        "properties": {
          "file_name": {
            "type": "string",
            "title": "File Name",
            "description": "Choose a name for your silo that is easy to remember and understand. Rest assured, the silo name will not affect development or any sensitive aspects.",
            "example": "app-config"
          },
          "file_data": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "object"
              }
            ],
            "title": "File Data",
            "description": "The data you want to store in the silo. It can be a JSON `object` or an `array of objects`.",
            "example": {
              "maintenance_mode": false,
              "min_app_version": "2.4.0",
              "features": {
                "new_checkout": true
              }
            }
          },
          "region_name": {
            "type": "string",
            "title": "Region Name",
            "enum": [
              "api",
              "sg-01-api",
              "usc-01-api"
            ],
            "description": "Choose the region where you want to store your data. Use `api` for the default region. The region must be available on your plan.",
            "example": "api"
          },
          "is_public": {
            "type": "boolean",
            "title": "Is Public",
            "default": false,
            "description": "Silo access mode. If `true`, the silo is public; if `false`, the silo is private.",
            "example": false
          }
        }
      },
      "UpdateSilo": {
        "type": "object",
        "title": "UpdateSilo",
        "properties": {
          "file_name": {
            "type": "string",
            "title": "File Name",
            "description": "A new name for the silo.",
            "example": "app-config"
          },
          "file_data": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "object"
              }
            ],
            "title": "File Data",
            "description": "New data for the silo. It replaces the existing data completely. If the silo has a locked schema, the data must match it.",
            "example": {
              "maintenance_mode": false,
              "min_app_version": "2.4.0",
              "features": {
                "new_checkout": true
              }
            }
          },
          "region_name": {
            "type": "string",
            "title": "Region Name",
            "enum": [
              "api",
              "sg-01-api",
              "usc-01-api"
            ],
            "description": "Move the silo to another region. The region must be available on your plan. Changing the region changes the silo's URL.",
            "example": "sg-01-api"
          },
          "is_public": {
            "type": "boolean",
            "title": "Is Public",
            "description": "Silo access mode. If `true`, the silo is public; if `false`, the silo is private. Changing the access mode changes the silo's URL.",
            "example": true
          }
        }
      },
      "SchemaViolation": {
        "type": "object",
        "title": "SchemaViolation",
        "properties": {
          "message": {
            "type": "string",
            "example": "Silo data does not match its locked schema."
          },
          "errors": {
            "type": "array",
            "description": "The first value that doesn't match the schema.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "A JSON Pointer to the invalid value.",
                  "example": "/products/1/price"
                },
                "message": {
                  "type": "string",
                  "description": "Why the value is invalid.",
                  "example": "Instance type \"string\" is invalid. Expected \"number\"."
                }
              }
            }
          }
        }
      },
      "TrialEnded": {
        "type": "object",
        "title": "TrialEnded",
        "properties": {
          "error": {
            "type": "string",
            "example": "Trial ended"
          },
          "code": {
            "type": "string",
            "example": "trial_ended"
          },
          "reason": {
            "type": "string",
            "enum": [
              "time",
              "cap"
            ],
            "description": "`time` when the trial period is over, `cap` when the trial's requests are used up.",
            "example": "time"
          },
          "upgrade_url": {
            "type": "string",
            "example": "https://console.jsonsilo.com/billing"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "description": "Returned when the request body doesn't have the expected fields and types.",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "description": "Details of which fields are invalid and why."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request. Either the request body has the wrong shape (for example `is_public` is not a boolean), which returns a JSON validation error, or `file_data` is larger than your plan's per-silo size limit, which returns a plain-text message.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "The maximum size for the silo is 5.00 MB. Current size is 6.20 MB."
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized. The Manage Key is invalid, was deleted, or has expired.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "examples": {
              "invalid": {
                "summary": "Invalid or deleted key",
                "value": "Invalid API Key"
              },
              "expired": {
                "summary": "Expired key",
                "value": "API Key Expired"
              }
            }
          }
        }
      },
      "TrialEnded": {
        "description": "Payment Required. The account's free trial has ended.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TrialEnded"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden. The `X-MAN-API` header is missing, or the request goes beyond what your plan allows, such as its silo limit or regions.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "Not authenticated"
          }
        }
      },
      "NotFound": {
        "description": "Not Found. The silo doesn't exist, the UUID is not valid, or the silo belongs to another account.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "File Not found or deleted"
          }
        }
      },
      "SchemaViolation": {
        "description": "Unprocessable Entity. The silo has a locked schema and `file_data` doesn't match it. Nothing was saved.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SchemaViolation"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Too Many Requests. You hit the burst limit (retry after a short pause) or the daily limit (wait for the window to reset or upgrade your plan).",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "examples": {
              "burst": {
                "summary": "Burst limit",
                "value": "Request limit exceeded"
              },
              "daily": {
                "summary": "Daily limit",
                "value": "Daily limit exceeded"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "silo_api_key": {
        "type": "apiKey",
        "description": "A JSONsilo Manage Key, sent in the `X-MAN-API` header. Create one in the console under **Keys > Manage keys**. A deleted or expired key returns `401`.",
        "in": "header",
        "name": "X-MAN-API"
      }
    },
    "headers": {
      "ManageSilo-Req-Limit": {
        "description": "Your daily Manage API request limit.",
        "schema": {
          "type": "integer",
          "example": 1000000
        }
      },
      "ManageSilo-Req-Remaining": {
        "description": "Requests left in the current 24-hour window.",
        "schema": {
          "type": "integer",
          "example": 999998
        }
      },
      "ManageSilo-Req-Reset": {
        "description": "When the window resets, as a Unix timestamp in seconds.",
        "schema": {
          "type": "integer",
          "example": 1755000000
        }
      }
    }
  },
  "tags": [
    {
      "name": "Manage",
      "description": "Manage silos and their JSON data with a Manage Key."
    }
  ]
}
